# Database Configuration
POSTGRES_DB=ai_dashboard
POSTGRES_USER=ai_dashboard
POSTGRES_PASSWORD=your_secure_db_password_here
DATABASE_URL=postgresql://ai_dashboard:your_secure_db_password_here@db:5432/ai_dashboard

# API Configuration
PORT=3000
APP_BASIC_USER=admin
APP_BASIC_PASSWORD=your_secure_api_password_here

# Web Configuration
WEB_PORT=8095

# Backup Configuration
TZ=Europe/Madrid
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30

# NAS-specific paths (Unraid)
# For Unraid, use: /mnt/user/appdata/app_ai_dashboard/postgres
# For local development, use: ./postgres_data
DB_DATA_PATH=/mnt/user/appdata/app_ai_dashboard/postgres
